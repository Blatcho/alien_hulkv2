{
  "name": "derelict",
  "version": "0.2.0",
  "description": "A side-on cut-away roguelike aboard a derelict starship. Browser only, controller first.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "test": "npm run test:unit && npm run test:glb && npm run test:smoke",
    "test:unit": "node --import ./tests/_resolve.mjs --test \"tests/**/*.test.mjs\"",
    "test:glb": "node tools/check-glb.mjs assets/models/*.glb",
    "test:smoke": "node tools/smoke.mjs",
    "models": "bash tools/build-models.sh",
    "assets": "python3 tools/gen_font.py && python3 tools/gen_audio.py"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "license": "MIT"
}
