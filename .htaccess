# Served alongside the game on Apache hosts (ignored elsewhere). The code and data files must not be
# cached for long: the game is updated in place and a stale script from an older build breaks boot.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|json|xml|htaccess)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(glb|ogg|png)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType model/gltf-binary .glb
  AddType audio/ogg .ogg
</IfModule>
